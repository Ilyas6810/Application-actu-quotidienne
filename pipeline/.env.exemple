# Copie ce fichier en .env (même dossier) et colle tes clés. Le fichier .env n'est jamais commité.
# Une seule clé suffit pour commencer : la cascade saute les fournisseurs sans clé.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Jeton de notification du téléphone (affiché dans l'écran Réglages de l'application).
# Facultatif : sert aux alertes et aux titres de 6 heures.
EXPO_PUSH_TOKEN=
